# ============================================================
#  APAS Telegram Bot — пример конфигурации
#  Скопируйте этот файл в .env и заполните своими значениями
#  НИКОГДА не коммитьте .env в публичные репозитории!
# ============================================================

# --- Telegram Bot ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# --- ИИ-провайдеры ---
# Groq (основной провайдер) — https://console.groq.com/
GROQ_API_KEY=your_groq_api_key

# Google Gemini — https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# --- Google Cloud Vertex AI (генерация изображений Imagen) ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Яндекс ---
# Yandex Cloud Foundation Models (YandexGPT) — https://console.yandex.cloud/
YANDEX_API_KEY=your_yandex_api_key

# Yandex Music (для режима Алисы, персональный токен администратора)
YANDEX_MUSIC_ADMIN_TOKEN=your_yandex_music_admin_token

# --- VK (ВКонтакте) ---
# VK Community Token — https://dev.vk.com/
VK_TOKEN=your_vk_community_token

# --- Администрирование ---
# Ваш Telegram user ID (администратор бота)
TELEGRAM_ID=123456789
# Пароль администратора (секретная фраза для /tools и критических постов)
ADMIN_PASSWORD=your_admin_password
